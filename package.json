{
  "name": "@nerima-games/mx-ui",
  "version": "0.3.9",
  "type": "module",
  "description": "Experience module for the nerima-games Minecraft-clone rebuild: every DOM surface — HUD, menus, inventory and crafting, settings and accessibility, achievements, captions and loading indicators.",
  "homepage": "https://github.com/nerima-games/mx-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mx-ui.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mx-ui/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "hud",
    "accessibility"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.preview.json --pretty false",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.release.json --pretty false",
    "lint": "oxlint --deny-warnings src apps scripts test test-browser && ast-grep scan",
    "lint:fix": "oxlint --fix src apps scripts test test-browser",
    "preview": "tsx apps/preview-screens/main.ts",
    "preview:browser": "vite --config apps/browser-harness/vite.config.ts",
    "test:browser": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "package:verify": "pnpm build && node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm verify && pnpm package:verify"
  },
  "dependencies": {
    "@nerima-games/mc-audio": "0.2.7",
    "@nerima-games/mc-kernel": "0.2.17",
    "@nerima-games/mc-sim": "0.1.39",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@effect/vitest": "0.30.0",
    "@playwright/test": "1.62.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "knip": "6.33.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
