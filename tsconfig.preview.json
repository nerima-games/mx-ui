{
  // The dev preview under apps/preview-screens.
  //
  // A SEPARATE project on purpose, and in this repository the reason is sharper
  // than in the others.
  //
  // tsconfig.build.json proves that the shipped source is BROWSER-ONLY: `types: []`
  // is inherited from tsconfig.base.json, so a `process.env` read — or any other
  // Node global — in `domain/` or `stages/` fails that project. That is the
  // guarantee tsconfig.base.json spells out in as many words ("mx-ui runs in a
  // browser, so a `process.env` read must not typecheck").
  //
  // The preview renders to a terminal and therefore needs Node's stdio. Adding
  // `types: ["node"]` to the build project to make that work would delete the
  // guarantee for the shipped source, which is the opposite of what a preview is
  // worth. So the preview gets its own project and tsconfig.build.json is left
  // exactly as it was.
  //
  // NOTE what this file does NOT do: it does not remove "DOM" from `lib` (it is
  // inherited, and harmless — the preview simply never touches it) and it does
  // not add `apps/**` to any other project. When the first real DOM screen is
  // written it belongs under `domain/` or a sibling module covered by
  // tsconfig.build.json, NOT here: `apps/` is where dev tools live, and code that
  // ships must be typechecked by the project that proves what it may depend on.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "apps/**/*.ts",
    "src/**/*.ts"
  ],
  "exclude": ["node_modules", "coverage", "dist"]
}
